{
  "name": "minacubo-redux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft-like voxel game built with Three.js, vanilla ES modules.",
  "scripts": {
    "dev": "npx serve .",
    "test": "vitest run",
    "test:watch": "vitest",
