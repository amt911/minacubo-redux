{
  "name": "minacubo-redux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft-like voxel game built with Three.js, vanilla ES modules.",
  "scripts": {
    "dev": "docker compose up",
    "dev:detached": "docker compose up -d",
    "dev:local": "npx serve .",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "rebuild": "docker compose build --no-cache",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "vitest": "^4.1.6"
  }
}
