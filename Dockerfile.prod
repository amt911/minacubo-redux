FROM node:20-alpine AS deps

WORKDIR /build
COPY package*.json ./
RUN npm ci --omit=dev

FROM nginx:alpine

COPY --from=deps /build/node_modules /usr/share/nginx/html/node_modules
COPY index.html /usr/share/nginx/html/
COPY estilo.css /usr/share/nginx/html/
COPY *.js /usr/share/nginx/html/
COPY texturas /usr/share/nginx/html/texturas

EXPOSE 80
